<?xml version="1.0" encoding="utf-8"?>
<!-- Gabarit's components for WinUI 3, from SkollN's design (the reference), as GabaritApple draws them on the Mac.
     It merges Gabarit.xaml (the generated colours, light and dark, sizes, text styles and WinUI's control resources):
     merge this one alone, after WinUI's, in App.xaml:
       <ResourceDictionary.MergedDictionaries>
         <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
         <ResourceDictionary Source="ms-appx:///Gabarit/Controls.xaml"/>
       </ResourceDictionary.MergedDictionaries>
     WinUI's own controls (ToggleSwitch, TextBox, ComboBox, Slider, ListView) take Gabarit's colours from Gabarit.xaml
     with no template redrawn; the buttons, the close cross, the window's header, cards and rail items are styled here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Gabarit/Gabarit.xaml"/>
        <ResourceDictionary Source="ms-appx:///Gabarit/Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Buttons: ink (primary), fine frame (secondary), no ground (ghost), red (danger). The hover and the press are a
         veil over the ground, never over the text: the veil (secondary, ghost), or a solid step of the ink (primary,
         danger), as on the Mac. -->

    <Style x:Key="GButtonCommonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CornerRadius" Value="{StaticResource GCornerRadiusSm}"/>
        <Setter Property="FontFamily" Value="{StaticResource GFontTextSemibold}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <!-- The keyboard's focus: the system's ring, in Gabarit's accent. -->
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GAccentBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="FocusVisualMargin" Value="-3"/>
    </Style>

    <Style x:Key="GButtonBaseStyle" TargetType="Button" BasedOn="{StaticResource GButtonCommonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Grid x:Name="Veil" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GTrackBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GButtonPrimaryStyle" TargetType="Button" BasedOn="{StaticResource GButtonCommonStyle}">
        <Setter Property="Background" Value="{ThemeResource GPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource GOnPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Grid x:Name="Veil" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GPrimaryHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GPrimaryPressedBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GButtonSecondaryStyle" TargetType="Button" BasedOn="{StaticResource GButtonBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource GSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource GTextPrimaryBrush}"/>
        <!-- The border at 60 %, as on the Mac and in GTK. -->
        <Setter Property="BorderBrush" Value="{ThemeResource GBorderSoftBrush}"/>
    </Style>

    <Style x:Key="GButtonGhostStyle" TargetType="Button" BasedOn="{StaticResource GButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource GTextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style x:Key="GButtonDangerStyle" TargetType="Button" BasedOn="{StaticResource GButtonCommonStyle}">
        <Setter Property="Background" Value="{ThemeResource GErrorBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource GOnPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Grid x:Name="Veil" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GErrorHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GErrorPressedBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A destructive secondary button ("Delete", "Leave"): no solid ground, its text in red. -->
    <Style x:Key="GButtonDestructiveStyle" TargetType="Button" BasedOn="{StaticResource GButtonSecondaryStyle}">
        <Setter Property="Foreground" Value="{ThemeResource GErrorBrush}"/>
    </Style>

    <!-- A sheet's main button: full height (44), primary. Another variant at that height: its style with MinHeight 44. -->
    <Style x:Key="GButtonRegularStyle" TargetType="Button" BasedOn="{StaticResource GButtonPrimaryStyle}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- The close button: a cross in a circle with a fine rim. Escape triggers it: put
         <KeyboardAccelerator Key="Escape"/> in its KeyboardAccelerators. Its name and tooltip are in English: an app in
         another language sets AutomationProperties.Name and ToolTipService.ToolTip on it ("Fermer", "Fermer (Échap)"). -->
    <Style x:Key="GCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource GButtonBaseStyle}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ThemeResource GHairlineBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource GTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Content" Value="{StaticResource GIcon_xmark}"/>
        <Setter Property="FontFamily" Value="{StaticResource GIconFont}"/>
        <Setter Property="AutomationProperties.Name" Value="Close"/>
        <Setter Property="AutomationProperties.AcceleratorKey" Value="Escape"/>
        <Setter Property="ToolTipService.ToolTip" Value="Close (Esc)"/>
    </Style>

    <!-- The same cross on the dark frame (a window's header). -->
    <Style x:Key="GCloseButtonOnFrameStyle" TargetType="Button" BasedOn="{StaticResource GCloseButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource GFrameRimBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GOnFrameBrush}"/>
    </Style>

    <!-- A window's header, extended into the title bar (AppWindow.TitleBar.ExtendsContentIntoTitleBar): 52 high, dark,
         the system's caption buttons (and Snap Layouts) kept on the right. Set it as the window's title bar
         (Window.SetTitleBar) so it moves the window. The right padding leaves room for the caption buttons: an app sets
         it from AppWindow.TitleBar.RightInset (and LeftInset), which follow the screen's scale and the reading
         direction. Set RequestedTheme="Dark" on the element itself: a style's RequestedTheme is not always applied. -->
    <Style x:Key="GWindowHeaderStyle" TargetType="Grid">
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="16,0,140,0"/>
        <Setter Property="Background" Value="{StaticResource GFrameBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GFrameLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="GWindowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextHeadline}">
        <Setter Property="Foreground" Value="{StaticResource GOnFrameBrush}"/>
    </Style>

    <Style x:Key="GWindowSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextCaption}">
        <Setter Property="Foreground" Value="{StaticResource GOnFrameDiscretBrush}"/>
    </Style>

    <!-- The main window's rail: 92 wide, dark (RequestedTheme="Dark" on the element); the page beside it in a sheet
         with a rounded top-left corner. -->
    <Style x:Key="GRailStyle" TargetType="StackPanel">
        <Setter Property="Width" Value="92"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Spacing" Value="4"/>
        <Setter Property="Background" Value="{StaticResource GFrameBrush}"/>
    </Style>

    <Style x:Key="GShellPageStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="12,0,0,0"/>
    </Style>

    <!-- A page of the rail: a radio button (GroupName "rail", IsChecked on the current page), so screen readers say
         which page is current. The icon and its name in its Content; the current one in rust on a slight ground, with a
         line on the left; a count on the icon: AutomationProperties.ItemStatus says it. -->
    <Style x:Key="GRailItemStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="52"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource GOnFrameDiscretBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource GFontTextMedium}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="CornerRadius" Value="{StaticResource GCornerRadiusSm}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource GPaletteRust400Brush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Rectangle x:Name="Bar" Width="2" Margin="0,6" HorizontalAlignment="Left"
                                   Fill="{StaticResource GPaletteRust400Brush}" Visibility="Collapsed"/>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource GFrameHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource GFrameSelectedBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Bar.Visibility" Value="Visible"/>
                                        <Setter Target="Root.Background" Value="{StaticResource GFrameSelectedBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{StaticResource GPaletteRust400Brush}"/>
                                        <Setter Target="Content.FontFamily" Value="{StaticResource GFontTextSemibold}"/>
                                        <Setter Target="Content.FontWeight" Value="SemiBold"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Forms: sections as cards, rows of a constant height split by a fine line. -->

    <Style x:Key="GCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource GHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource GCornerRadiusLg}"/>
    </Style>

    <Style x:Key="GRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="16,8"/>
    </Style>

    <Style x:Key="GPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextLargeTitle}">
        <Setter Property="Foreground" Value="{ThemeResource GTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="GSectionFooterStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextCallout}">
        <Setter Property="Foreground" Value="{ThemeResource GTextDiscretBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Badges: the hover's veil with no state; the states through their brushes (GSuccessBrush…) at 14 %. -->
    <Style x:Key="GBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="CornerRadius" Value="{StaticResource GCornerRadiusSm}"/>
        <Setter Property="Background" Value="{ThemeResource GHoverBrush}"/>
    </Style>

    <!-- A passing message: the ink of a primary button. -->
    <Style x:Key="GToastStyle" TargetType="Border">
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="CornerRadius" Value="{StaticResource GCornerRadiusMd}"/>
        <Setter Property="Background" Value="{ThemeResource GPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
