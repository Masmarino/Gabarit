<?xml version="1.0" encoding="utf-8"?>
<!-- Gabarit's components for WinUI 3, from SkollN's design (the reference), as GabaritApple draws them on the Mac.
     It merges Gabarit.xaml (the generated colours, light and dark, sizes, text styles and WinUI's control resources):
     merge this one alone, after WinUI's, in App.xaml:
       <ResourceDictionary.MergedDictionaries>
         <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
         <ResourceDictionary Source="ms-appx:///Gabarit/Controls.xaml"/>
       </ResourceDictionary.MergedDictionaries>
     WinUI's own controls (TextBox, ComboBox, Slider, ListView) take Gabarit's colours from Gabarit.xaml with no template
     redrawn; the buttons, the switch, the close cross, the window's header, cards and rail items are styled here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Gabarit/Gabarit.xaml"/>
        <ResourceDictionary Source="ms-appx:///Gabarit/Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Buttons: ink (primary), fine frame (secondary), no ground (ghost), red (danger). The hover and the press are a
         veil over the ground, never over the text: the veil (secondary, ghost), or a solid step of the ink (primary,
         danger), as on the Mac. -->

    <SolidColorBrush x:Key="GReliefOnInkBrush" Color="#2EFFFFFF"/>
    <!-- Held down: the shade falls from the top edge. -->
    <LinearGradientBrush x:Key="GReliefSunkBrush" StartPoint="0,0" EndPoint="0,0.45">
        <GradientStop Offset="0" Color="#24000000"/>
        <GradientStop Offset="1" Color="#00000000"/>
    </LinearGradientBrush>
    <!-- A little volume on what can be pressed: lighter at the top, a touch darker at the bottom. -->
    <LinearGradientBrush x:Key="GReliefVolumeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#12FFFFFF"/>
        <GradientStop Offset="0.5" Color="#00FFFFFF"/>
        <GradientStop Offset="1" Color="#0A000000"/>
    </LinearGradientBrush>

    <Style x:Key="GButtonCommonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CornerRadius" Value="{StaticResource GCornerRadiusSm}"/>
        <Setter Property="FontFamily" Value="{StaticResource GFontTextSemibold}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <!-- The keyboard's focus: the system's ring, in Gabarit's accent. -->
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GAccentBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="FocusVisualMargin" Value="-3"/>
    </Style>

    <Style x:Key="GButtonBaseStyle" TargetType="Button" BasedOn="{StaticResource GButtonCommonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Grid x:Name="Veil" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid.BackgroundTransition><BrushTransition Duration="0:0:0.12"/></Grid.BackgroundTransition>
                        </Grid>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GPressBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GButtonPrimaryStyle" TargetType="Button" BasedOn="{StaticResource GButtonCommonStyle}">
        <Setter Property="Background" Value="{ThemeResource GPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource GOnPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Grid x:Name="Veil" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid.BackgroundTransition><BrushTransition Duration="0:0:0.12"/></Grid.BackgroundTransition>
                        </Grid>
                        <Border x:Name="Sunk" Background="{StaticResource GReliefSunkBrush}" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <!-- The light on the top edge: what can be pressed stands above the page, and sinks when pressed. -->
                        <Border x:Name="Relief" Background="{StaticResource GReliefVolumeBrush}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource GReliefOnInkBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GPrimaryHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Relief.Opacity" Value="0"/>
                                        <Setter Target="Sunk.Opacity" Value="1"/>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GPrimaryPressedBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GButtonSecondaryStyle" TargetType="Button" BasedOn="{StaticResource GButtonBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource GSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource GTextPrimaryBrush}"/>
        <!-- The border at 60 %, as on the Mac and in GTK. -->
        <Setter Property="BorderBrush" Value="{ThemeResource GBorderSoftBrush}"/>
        <!-- Hovered, its border a little stronger (80 %), as on the Mac. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Grid x:Name="Veil" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid.BackgroundTransition><BrushTransition Duration="0:0:0.12"/></Grid.BackgroundTransition>
                        </Grid>
                        <Border x:Name="Sunk" Background="{StaticResource GReliefSunkBrush}" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <!-- The light on the top edge: what can be pressed stands above the page, and sinks when pressed. -->
                        <Border x:Name="Relief" Background="{StaticResource GReliefVolumeBrush}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource GReliefHighlightBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GHoverBrush}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource GBorderStrongBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Relief.Opacity" Value="0"/>
                                        <Setter Target="Sunk.Opacity" Value="1"/>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GPressBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GButtonGhostStyle" TargetType="Button" BasedOn="{StaticResource GButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource GTextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style x:Key="GButtonDangerStyle" TargetType="Button" BasedOn="{StaticResource GButtonCommonStyle}">
        <Setter Property="Background" Value="{ThemeResource GErrorBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource GOnPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Grid x:Name="Veil" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid.BackgroundTransition><BrushTransition Duration="0:0:0.12"/></Grid.BackgroundTransition>
                        </Grid>
                        <Border x:Name="Sunk" Background="{StaticResource GReliefSunkBrush}" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <!-- The light on the top edge: what can be pressed stands above the page, and sinks when pressed. -->
                        <Border x:Name="Relief" Background="{StaticResource GReliefVolumeBrush}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource GReliefOnInkBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GErrorHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Relief.Opacity" Value="0"/>
                                        <Setter Target="Sunk.Opacity" Value="1"/>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GErrorPressedBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A destructive secondary button ("Delete", "Leave"): no solid ground, its text in red. -->
    <Style x:Key="GButtonDestructiveStyle" TargetType="Button" BasedOn="{StaticResource GButtonSecondaryStyle}">
        <!-- The text's red: 4.5:1 on the hover's and the press's grounds too. -->
        <Setter Property="Foreground" Value="{ThemeResource GErrorTextBrush}"/>
    </Style>

    <!-- A sheet's main button: full height (44), primary. Another variant at that height: its style with MinHeight 44. -->
    <Style x:Key="GButtonRegularStyle" TargetType="Button" BasedOn="{StaticResource GButtonPrimaryStyle}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- The close button: a cross in a circle with a fine rim. Escape triggers it: put
         <KeyboardAccelerator Key="Escape"/> in its KeyboardAccelerators. Its name and tooltip are in English: an app in
         another language sets AutomationProperties.Name and ToolTipService.ToolTip on it ("Fermer", "Fermer (Échap)"). -->
    <Style x:Key="GCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource GButtonBaseStyle}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ThemeResource GHairlineBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource GTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Content" Value="{StaticResource GIcon_xmark}"/>
        <Setter Property="FontFamily" Value="{StaticResource GIconFont}"/>
        <Setter Property="AutomationProperties.Name" Value="Close"/>
        <Setter Property="AutomationProperties.AcceleratorKey" Value="Escape"/>
        <Setter Property="ToolTipService.ToolTip" Value="Close (Esc)"/>
    </Style>

    <!-- The same cross on the dark frame (a window's header). -->
    <Style x:Key="GCloseButtonOnFrameStyle" TargetType="Button" BasedOn="{StaticResource GCloseButtonStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource GFrameRimBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource GOnFrameBrush}"/>
        <!-- The frame's veils, whatever the page's appearance. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Grid x:Name="Veil" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid.BackgroundTransition><BrushTransition Duration="0:0:0.12"/></Grid.BackgroundTransition>
                        </Grid>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GFrameCloseHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GFrameCloseHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A window's header, extended into the title bar (AppWindow.TitleBar.ExtendsContentIntoTitleBar): 52 high, dark,
         the system's caption buttons (and Snap Layouts) kept on the right. Set it as the window's title bar
         (Window.SetTitleBar) so it moves the window. The right padding leaves room for the caption buttons: an app sets
         it from AppWindow.TitleBar.RightInset (and LeftInset), which follow the screen's scale and the reading
         direction. Set RequestedTheme="Dark" on the element itself: a style's RequestedTheme is not always applied. -->
    <Style x:Key="GWindowHeaderStyle" TargetType="Grid">
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="16,0,140,0"/>
        <Setter Property="Background" Value="{ThemeResource GFrameBrush}"/>
        <!-- The line is translucent, over the frame and not over whatever is behind the header. -->
        <Setter Property="BackgroundSizing" Value="OuterBorderEdge"/>
        <Setter Property="BorderBrush" Value="{ThemeResource GFrameLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="GWindowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextHeadline}">
        <Setter Property="Foreground" Value="{ThemeResource GOnFrameBrush}"/>
    </Style>

    <Style x:Key="GWindowSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextCaption}">
        <Setter Property="Foreground" Value="{ThemeResource GOnFrameDiscretBrush}"/>
    </Style>

    <!-- The main window's rail: 92 wide, dark (RequestedTheme="Dark" on the element); the page beside it in a sheet
         with a rounded top-left corner: a ContentControl with GShellPageStyle, which draws the frame behind that corner. -->
    <Style x:Key="GRailStyle" TargetType="StackPanel">
        <Setter Property="Width" Value="92"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Spacing" Value="4"/>
        <Setter Property="Background" Value="{ThemeResource GFrameBrush}"/>
    </Style>

    <Style x:Key="GShellPageStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="{ThemeResource GBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="12,0,0,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <!-- The frame behind the rounded corner, whatever is behind the page. -->
                    <Grid Background="{ThemeResource GFrameBrush}">
                        <ContentPresenter Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A page of the rail: a radio button (GroupName "rail", IsChecked on the current page), so screen readers say
         which page is current. The icon and its name in its Content; the current one in rust on a slight ground, with a
         line on the left; a count on the icon: AutomationProperties.ItemStatus says it. -->
    <Style x:Key="GRailItemStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="52"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource GOnFrameDiscretBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource GFontTextMedium}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="CornerRadius" Value="{StaticResource GCornerRadiusSm}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GOnFrameAccentBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <!-- The current page's ground and the hover's veil on their own layers: the two states never write the
                             same property. -->
                        <Grid x:Name="Selection" Background="{ThemeResource GFrameSelectedBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                        <Grid x:Name="Veil" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid.BackgroundTransition><BrushTransition Duration="0:0:0.12"/></Grid.BackgroundTransition>
                        </Grid>
                        <Rectangle x:Name="Bar" Width="2" Margin="0,6" HorizontalAlignment="Left"
                                   Fill="{ThemeResource GOnFrameAccentBrush}" Visibility="Collapsed"/>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GFrameHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GFrameCloseHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Bar.Visibility" Value="Visible"/>
                                        <Setter Target="Selection.Opacity" Value="1"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource GOnFrameAccentBrush}"/>
                                        <Setter Target="Content.FontFamily" Value="{StaticResource GFontTextSemibold}"/>
                                        <Setter Target="Content.FontWeight" Value="SemiBold"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Forms: sections as cards, rows of a constant height split by a fine line. -->

    <Style x:Key="GCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource GHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource GCornerRadiusLg}"/>
    </Style>

    <Style x:Key="GRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="16,8"/>
    </Style>

    <Style x:Key="GPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextLargeTitle}">
        <Setter Property="Foreground" Value="{ThemeResource GTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="GSectionFooterStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextCallout}">
        <Setter Property="Foreground" Value="{ThemeResource GTextDiscretBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Badges: the hover's veil with no state; a state's tint with GBadgeSuccessStyle… (and its text style). -->
    <Style x:Key="GBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="CornerRadius" Value="{StaticResource GCornerRadiusSm}"/>
        <Setter Property="Background" Value="{ThemeResource GHoverBrush}"/>
    </Style>

    <!-- A badge's text, and the states' tints (a tone at 14 %, its readable text on it). -->
    <Style x:Key="GBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextCaption2}">
        <Setter Property="FontFamily" Value="{StaticResource GFontTextSemibold}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource GTextSecondaryBrush}"/>
    </Style>

    <Style x:Key="GBadgeSuccessStyle" TargetType="Border" BasedOn="{StaticResource GBadgeStyle}">
        <Setter Property="Background" Value="{ThemeResource GSuccessTintBrush}"/>
    </Style>
    <Style x:Key="GBadgeSuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GBadgeTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource GSuccessOnTintBrush}"/>
    </Style>

    <Style x:Key="GBadgeWarningStyle" TargetType="Border" BasedOn="{StaticResource GBadgeStyle}">
        <Setter Property="Background" Value="{ThemeResource GWarningTintBrush}"/>
    </Style>
    <Style x:Key="GBadgeWarningTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GBadgeTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource GWarningOnTintBrush}"/>
    </Style>

    <Style x:Key="GBadgeErrorStyle" TargetType="Border" BasedOn="{StaticResource GBadgeStyle}">
        <Setter Property="Background" Value="{ThemeResource GErrorTintBrush}"/>
    </Style>
    <Style x:Key="GBadgeErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GBadgeTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource GErrorOnTintBrush}"/>
    </Style>

    <Style x:Key="GBadgeInfoStyle" TargetType="Border" BasedOn="{StaticResource GBadgeStyle}">
        <Setter Property="Background" Value="{ThemeResource GInfoTintBrush}"/>
    </Style>
    <Style x:Key="GBadgeInfoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GBadgeTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource GInfoOnTintBrush}"/>
    </Style>

    <!-- A passing message: the ink of a primary button, its text in GToastTextStyle, 32 above the bottom. To float, the
         Border itself takes Translation="0,0,16" and a ThemeShadow as its Shadow (a style cannot set them: they are not
         dependency properties). One at a time. -->
    <Style x:Key="GToastStyle" TargetType="Border">
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="CornerRadius" Value="{StaticResource GCornerRadiusMd}"/>
        <Setter Property="Background" Value="{ThemeResource GPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,0,32"/>
    </Style>

    <Style x:Key="GToastTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextSubheadline}">
        <Setter Property="FontFamily" Value="{StaticResource GFontTextMedium}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{ThemeResource GOnPrimaryBrush}"/>
    </Style>

    <!-- Chips side by side (two to four short options): RadioButtons with the same GroupName, the current one tinted
         rust. A selection on its own layer, the hover's veil on another. -->
    <Style x:Key="GChipStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="{StaticResource GCornerRadiusSm}"/>
        <Setter Property="Background" Value="{ThemeResource GBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource GTextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource GFontTextMedium}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GAccentBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Border x:Name="Rim" BorderBrush="{ThemeResource GHairlineBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Grid x:Name="Veil" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid.BackgroundTransition><BrushTransition Duration="0:0:0.12"/></Grid.BackgroundTransition>
                        </Grid>
                        <Border x:Name="Sunk" Background="{StaticResource GReliefSunkBrush}" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <Border x:Name="Selection" Background="{ThemeResource GSelectedFillBrush}" BorderBrush="{ThemeResource GAccentRimBrush}"
                                BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GHoverBrush}"/>
                                        <Setter Target="Rim.BorderBrush" Value="{ThemeResource GBorderHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Sunk.Opacity" Value="1"/>
                                        <Setter Target="Veil.Background" Value="{ThemeResource GPressBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Selection.Opacity" Value="1"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource GAccentTextBrush}"/>
                                        <Setter Target="Content.FontFamily" Value="{StaticResource GFontTextSemibold}"/>
                                        <Setter Target="Content.FontWeight" Value="SemiBold"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Underlined tabs: RadioButtons with the same GroupName in a StackPanel (Spacing 20) over a fine line; the current
         one in the text's colour, semibold, a rust line under it; a softer line under the hovered one. -->
    <Style x:Key="GNavTabStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource GTextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource GFontTextMedium}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GAccentBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Rectangle x:Name="HoverLine" Height="2" VerticalAlignment="Bottom" Fill="{ThemeResource GBorderHoverBrush}" Opacity="0"/>
                        <Rectangle x:Name="Line" Height="2" VerticalAlignment="Bottom" Fill="{ThemeResource GAccentBrush}" Opacity="0"/>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLine.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLine.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Line.Opacity" Value="1"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource GTextPrimaryBrush}"/>
                                        <Setter Target="Content.FontFamily" Value="{StaticResource GFontTextSemibold}"/>
                                        <Setter Target="Content.FontWeight" Value="SemiBold"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A switch row: a Grid, the title (GTextBody) and its sentence (GSwitchDetailStyle) on the left, a ToggleSwitch
         with this style on the right; its AutomationProperties.Name is the title. As on the Mac: 36 by 20, a knob of 16,
         the rim stronger under the pointer, the knob stretched when held down. Its own template, because WinUI's stays 154
         wide inside (a MinWidth on a Grid of its template) and keeps a column for its On/Off words. The part names are
         WinUI's: ToggleSwitch moves the knob by them. -->
    <Style x:Key="GSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ManipulationMode" Value="System,TranslateX"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GAccentBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="FocusVisualMargin" Value="-3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid x:Name="Root" Width="36" Height="20" Background="Transparent" CornerRadius="10" Control.IsTemplateFocusTarget="True">
                        <Rectangle x:Name="OuterBorder" RadiusX="10" RadiusY="10" StrokeThickness="1"
                                   Fill="{ThemeResource ToggleSwitchFillOff}" Stroke="{ThemeResource ToggleSwitchStrokeOff}"/>
                        <Rectangle x:Name="SwitchKnobBounds" RadiusX="10" RadiusY="10" StrokeThickness="1" Opacity="0"
                                   Fill="{ThemeResource ToggleSwitchFillOn}" Stroke="{ThemeResource ToggleSwitchStrokeOn}"/>
                        <Grid x:Name="SwitchKnob" Width="22" Height="20" HorizontalAlignment="Left">
                            <Grid.RenderTransform><TranslateTransform x:Name="KnobTranslateTransform"/></Grid.RenderTransform>
                            <Ellipse x:Name="SwitchKnobOff" Width="16" Height="16" Margin="2,0,0,0" HorizontalAlignment="Left"
                                     Fill="{ThemeResource ToggleSwitchKnobFillOff}"/>
                            <Ellipse x:Name="SwitchKnobOn" Width="16" Height="16" Margin="0,0,2,0" HorizontalAlignment="Right" Opacity="0"
                                     Fill="{ThemeResource ToggleSwitchKnobFillOn}"/>
                        </Grid>
                        <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Stroke" Value="{ThemeResource ToggleSwitchStrokeOffPointerOver}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="SwitchKnobOff.Width" Value="19"/>
                                        <Setter Target="SwitchKnobOn.Width" Value="19"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource GOpacityDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="Dragging" To="On" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobCurrentToOnOffset}"/>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="Dragging" To="Off" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobCurrentToOffOffset}"/>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="On" To="Off" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobOnToOffOffset}"/>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="Off" To="On" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobOffToOnOffset}"/>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Dragging"/>
                                <VisualState x:Name="Off"/>
                                <VisualState x:Name="On">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="14" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GSwitchDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextCaption}">
        <Setter Property="Foreground" Value="{ThemeResource GTextDiscretBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Titles and texts of forms. -->

    <Style x:Key="GFieldTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextCaption}">
        <Setter Property="FontFamily" Value="{StaticResource GFontTextSemibold}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource GTextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="GSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextHeadline}">
        <Setter Property="Foreground" Value="{ThemeResource GTextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
    </Style>

    <Style x:Key="GPageSummaryStyle" TargetType="TextBlock" BasedOn="{StaticResource GTextBody}">
        <Setter Property="Foreground" Value="{ThemeResource GTextDiscretBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>
